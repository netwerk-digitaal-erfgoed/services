PREFIX picom: <https://personsincontext.org/model#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX schema: <http://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

CONSTRUCT {
    ?uri a skos:Concept, schema:Person ;
        ?constructedProperty ?value ;
        skos:hiddenLabel ?hiddenLabel .
    ?value schema:name ?relativeName .
}
# See the search query, queries/search/wo2personen.rq, for how the properties are read.
WHERE {
    VALUES ?uri { ?uris }
    ?uri a picom:PersonReconstruction ;
        ?property ?value .
    VALUES (?property ?constructedProperty) {
        (schema:name skos:prefLabel)
        (schema:alternateName skos:altLabel)
        (schema:sameAs skos:exactMatch)
        (schema:birthDate schema:birthDate)
        (schema:deathDate schema:deathDate)
        (schema:birthPlace schema:birthPlace)
        (schema:deathPlace schema:deathPlace)
        (schema:gender schema:gender)
        (schema:parent schema:parent)
        (schema:children schema:children)
        (schema:spouse schema:spouse)
        (schema:sibling schema:sibling)
    }

    # A relative is a reconstruction too, named on the row that states the relation, so its names do
    # not multiply against the person’s other properties. Of the values above, only a relative is a
    # reconstruction.
    OPTIONAL {
        ?value a picom:PersonReconstruction ;
            schema:name ?relativeName .
    }

    OPTIONAL {
        ?uri prov:wasDerivedFrom ?observation .
        ?observation schema:name|schema:alternateName ?hiddenLabel .
    }
}
