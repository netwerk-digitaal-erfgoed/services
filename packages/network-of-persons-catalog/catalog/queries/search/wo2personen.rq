PREFIX picom: <https://personsincontext.org/model#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX ql: <http://qlever.cs.uni-freiburg.de/builtin-functions/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <https://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

CONSTRUCT {
    ?uri a ?conceptClass, ?personClass ;
        ?constructedProperty ?value ;
        ?constructedObservationProperty ?observationValue ;
        schema:familyName ?familyName .
    ?value schema:name ?relativeName, ?placeName .
}
WHERE {
    # Each branch repeats the search subquery, which QLever computes once and caches, so that each
    # joins only the persons found. QLever evaluates a pattern outside the subquery – an OPTIONAL,
    # or a UNION branch without the subquery – over the whole dataset before it joins it to the
    # results: for the observations, that took 2.4 of a search’s 3.3 seconds, or ran QLever out of
    # memory.
    {
        {
            # The text index covers every literal of every resource, so a search for ‘beverwijk’
            # also hits the 953 persons born or deceased there. Only a hit on a name counts.
            SELECT ?uri (MIN(STRLEN(STR(?matchedName))) AS ?matchedNameLength) WHERE {
                ?text ql:contains-word ?query ;
                    ql:contains-entity ?hit .
                ?hit schema:name|schema:alternateName ?matchedName .
                FILTER(STR(?matchedName) = STR(?text))
                # A reconstruction is the person; an observation is one mention of that person in
                # a source. A hit on an observation’s spelling finds the reconstruction derived
                # from it, so every result is a reconstruction.
                {
                    ?hit a picom:PersonReconstruction .
                    BIND(?hit AS ?uri)
                }
                UNION
                {
                    ?uri prov:wasDerivedFrom ?hit ;
                        a picom:PersonReconstruction .
                }
            }
            GROUP BY ?uri
            # A matched name contains every search word, so the shortest ones are the closest
            # matches. Without an order, a common name returns an arbitrary part of its hits.
            ORDER BY ?matchedNameLength ?uri
            #LIMIT#
        }

        # The person’s own properties in one pattern, renamed where the Network of Terms reads
        # another property. A UNION branch per property is evaluated for the whole dataset before
        # it is joined to the results, which took a search from 1 to 19 seconds. A place is stated
        # as a name and, for some persons, as a WO2 Thesaurus location beside it, with nothing
        # pairing the two; both are constructed, the location named by its preferred label below.
        #
        # Every reconstruction has exactly one name, so the name row constructs the classes once
        # per person. See “Triples a person has once come from one row” in the catalog README.
        ?uri ?property ?value .
        VALUES (?property ?constructedProperty ?conceptClass ?personClass) {
            (schema:name skos:prefLabel skos:Concept schema:Person)
            (schema:alternateName skos:altLabel UNDEF UNDEF)
            (schema:sameAs skos:exactMatch UNDEF UNDEF)
            (schema:birthDate schema:birthDate UNDEF UNDEF)
            (schema:deathDate schema:deathDate UNDEF UNDEF)
            (schema:birthPlace schema:birthPlace UNDEF UNDEF)
            (schema:deathPlace schema:deathPlace UNDEF UNDEF)
            (schema:gender schema:gender UNDEF UNDEF)
            (schema:parent schema:parent UNDEF UNDEF)
            (schema:children schema:children UNDEF UNDEF)
            (schema:spouse schema:spouse UNDEF UNDEF)
            (schema:sibling schema:sibling UNDEF UNDEF)
            # The observations the reconstruction was derived from: pages on Oorlogslevens.
            (prov:wasDerivedFrom rdfs:seeAlso UNDEF UNDEF)
        }

        # A relative is a reconstruction too, named on the row that states the relation, so its
        # names do not multiply against the person’s other properties. Of the values above, only a
        # relative is a reconstruction.
        OPTIONAL {
            ?value a picom:PersonReconstruction ;
                schema:name ?relativeName .
        }

        # A place the source identifies is a WO2 Thesaurus location, named by its preferred label.
        OPTIONAL {
            ?value skos:prefLabel ?placeName .
        }
    }
    UNION
    {
        {
            # The same search, which QLever takes from its cache.
            SELECT ?uri (MIN(STRLEN(STR(?matchedName))) AS ?matchedNameLength) WHERE {
                ?text ql:contains-word ?query ;
                    ql:contains-entity ?hit .
                ?hit schema:name|schema:alternateName ?matchedName .
                FILTER(STR(?matchedName) = STR(?text))
                {
                    ?hit a picom:PersonReconstruction .
                    BIND(?hit AS ?uri)
                }
                UNION
                {
                    ?uri prov:wasDerivedFrom ?hit ;
                        a picom:PersonReconstruction .
                }
            }
            GROUP BY ?uri
            ORDER BY ?matchedNameLength ?uri
            #LIMIT#
        }

        # Spellings found in the sources: matched on, never shown.
        #
        # The name parts come from the observations too, as the reconstructions state none: WO2Net
        # names a reconstruction for display only, without a claim about its given and family
        # name. Observations that disagree give the person more than one.
        #
        # One pattern for all four properties, so an observation gives a row per value: in separate
        # OPTIONALs they multiply, and one observation states 22 names, 16 alternate names, 16 given
        # names and 9 family names. Only a family name multiplies, by the names, to find its prefix
        # in.
        ?uri prov:wasDerivedFrom ?observation .
        ?observation ?observationProperty ?observationValue .
        VALUES (?observationProperty ?constructedObservationProperty) {
            (schema:name skos:hiddenLabel)
            (schema:alternateName skos:hiddenLabel)
            (schema:givenName schema:givenName)
            (schema:familyName UNDEF)
        }
        # The family name row also needs the names to find its prefix in, below.
        OPTIONAL {
            ?observation schema:name ?observationName .
            VALUES ?observationProperty { schema:familyName }
        }

        # Some sources leave the prefix out of the family name (‘Vries’ for Dick de Vries), and no
        # property states it. It is the lowercase words before the family name at the end of the
        # observation’s name. Bound here, after the joins: inside the OPTIONAL, QLever computes it
        # for every observation in the dataset, which took a search from 1 to 15 seconds.
        BIND(SUBSTR(?observationName, 1, STRLEN(?observationName) - STRLEN(?observationValue) - 1) AS ?nameBeforeFamilyName)
        BIND(IF(
            STRENDS(?observationName, CONCAT(" ", ?observationValue)) && REGEX(?nameBeforeFamilyName, " [a-z'’]+$"),
            CONCAT(REPLACE(?nameBeforeFamilyName, "^.*? ((?:[a-z'’]+ ?)+)$", "$1"), " ", ?observationValue),
            ?observationValue
        ) AS ?prefixedFamilyName)
        # ?unbound is never bound, so the other rows bind no family name.
        BIND(IF(?observationProperty = schema:familyName, COALESCE(?prefixedFamilyName, ?observationValue), ?unbound) AS ?familyName)
    }
}
