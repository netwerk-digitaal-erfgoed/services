  ],
  "description": [
    {
      "@language": "en",
      "@value": "The person reconstructions in the Gouda Time Machine knowledge graph: historical persons of Gouda, each bringing together the mentions of that person in the records of the Midden-Holland Regional Archive and Open Archives, in the Persons in Context (PiCo) model"
    },
    {
      "@language": "nl",
      "@value": "De persoonsreconstructies in de kennisgraaf van de Gouda Tijdmachine: historische Goudse personen, elk een samenvoeging van de vermeldingen van die persoon in de akten van het Streekarchief Midden-Holland en Open Archieven, in het Persons in Context (PiCo) model"
    }
  ],
  "inLanguage": "nl",
  "license": { "@id": "https://creativecommons.org/publicdomain/zero/1.0/" },
  "distribution": [
    {
      "@id": "https://n2t.net/ark:/60537/b0044kp",
      "@type": "DataDownload",
      "contentUrl": "https://sparql.goudatijdmachine.nl/",
      "encodingFormat": "application/sparql-query",
      "potentialAction": [
        {
          "@type": "SearchAction",
          "query": "file://../queries/search/gtm-pico.rq"
        },
        {
          "@type": "FindAction",
          "query": "file://../queries/lookup/gtm-pico.rq"
        },
        {
          "@type": "Action",
          "target": {
            "@type": "EntryPoint",
            "actionApplication": {
              "@id": "https://reconciliation-api.github.io/specs/latest/",
              "@type": "SoftwareApplication"
            },
            "urlTemplate": "https://personennetwerk.netwerkdigitaalerfgoed.nl/reconcile/{dataset}"
          }
        }
      ]
    }
  ]
